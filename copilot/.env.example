# Configuration de l'environnement pour le Copilote Agentique (FastAPI + n8n)

# Clé API d'accès au backend FastAPI
COPILOT_API_KEY=dev-secret-key

# Clé API LLM pour l'agent (Gemini, Claude, OpenAI ou DeepSeek)
LLM_API_KEY=votre_cle_api_ici

# Port du serveur n8n
N8N_PORT=5678

# Port du serveur API FastAPI
API_PORT=8000
